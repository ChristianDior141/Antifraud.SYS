POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=kyc_aml_db
POSTGRES_PORT=5432

# development | staging | production
# In production the app refuses to start with default/empty secrets.
ENVIRONMENT=development

SECRET_KEY=change_this_to_a_very_long_random_secret_key_in_production
# Key for encrypting PII / document files at rest. Any high-entropy secret.
# Falls back to SECRET_KEY in development; REQUIRED in production.
ENCRYPTION_KEY=change_this_to_a_separate_long_random_encryption_key
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Authentication hardening
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# HTTP hardening — comma/JSON list of allowed Host headers, e.g. ["api.example.com"]
# Leave as ["*"] only in development.
ALLOWED_HOSTS=["*"]
# Set true only when served strictly over HTTPS (adds HSTS header)
ENABLE_HSTS=false

REDIS_URL=redis://redis:6379
# Rate-limit storage: memory:// (single instance) or redis://redis:6379 (shared/scaled)
RATE_LIMIT_STORAGE_URI=redis://redis:6379

FIRST_SUPERUSER_EMAIL=admin@kyc-platform.com
FIRST_SUPERUSER_PASSWORD=Admin123!@#
